{
  "name": "GCAP3226 Week 4",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "waitFor": "postCreateCommand",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt && python -m ipykernel install --user --name gcap3226 --display-name \"Python 3 (GCAP3226)\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.createEnvironment.trigger": "off",
        "python.terminal.activateEnvironment": false,
        "notebook.output.textLineLimit": 100
      }
    }
  },
  "remoteUser": "vscode"
}
